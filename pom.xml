<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.cibseven.community</groupId>
  <artifactId>rest-datasonnet-connector</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>rest-datasonnet connector</name>
  <description>
    CIB seven (Camunda 7 fork) Connect SPI connector for calling external REST
    APIs with DataSonnet request/response/error mapping and a business-vs-system
    error model. See docs/ for the reviewed design.
  </description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>11</maven.compiler.release>
    <cibseven.version>2.1.0</cibseven.version>
    <datasonnet.version>2.5.2</datasonnet.version>
    <httpclient5.version>5.5</httpclient5.version>
    <jackson.version>2.15.0</jackson.version>
    <junit.version>5.11.3</junit.version>
  </properties>

  <!--
    Pin every Jackson artifact to one version. datasonnet-mapper 2.5.2 brings
    Jackson 2.15.0 transitively (jackson-core / databind / annotations plus the
    csv, yaml and properties dataformats); importing the matching jackson-bom
    locks them, so a future datasonnet bump cannot silently split the Jackson
    version across the tree. 2.15.0 is the version the connector is built and
    tested against. The maven-enforcer dependencyConvergence rule guards it.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      CIB seven Connect SPI (cibseven-connect-core 2.1.0): AbstractConnector,
      ConnectorProvider, ConnectorException, under the org.cibseven.connect.*
      namespace (CIB seven 2.x; the 1.x line used org.camunda.connect.*).
      provided scope: the engine supplies it. Pinned to CIB seven 2.1.0 — the
      version the other CIB seven plugins in this workspace target.
    -->
    <dependency>
      <groupId>org.cibseven.connect</groupId>
      <artifactId>cibseven-connect-core</artifactId>
      <version>${cibseven.version}</version>
      <scope>provided</scope>
    </dependency>

    <!--
      Apache HttpClient 5.5, pinned via the httpclient5.version property.
      Verified as the version CIB seven 2.1.0 ships: cibseven-parent 2.1.0 sets
      version.httpclient5 = 5.5. provided scope: the connector compiles against
      it but does not bundle it — it relies on httpclient5 already being on the
      CIB seven engine classpath, where the engine's own connect modules put it
      (docs/design.md section 4).
    -->
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
      <version>${httpclient5.version}</version>
      <scope>provided</scope>
    </dependency>

    <!--
      datasonnet-mapper, pinned to 2.5.2 via the datasonnet.version property:
      the latest stable release in the javax-namespace 2.x line, matching CIB
      seven 2.x's javax cibseven-engine (the 2.5.x-jakarta4 builds target the
      Jakarta variant instead). It transitively brings the Scala runtime,
      sjsonnet, and Jackson; the process-level test runs it alongside the
      engine's own Jackson with no clash.
    -->
    <dependency>
      <groupId>com.datasonnet</groupId>
      <artifactId>datasonnet-mapper</artifactId>
      <version>${datasonnet.version}</version>
    </dependency>

    <!--
      DataSonnet 2.5.x's Java format plugin references javax.xml.bind (JAXB),
      which was removed from the JDK in Java 11. Bundle the javax-namespaced
      JAXB runtime so the connector works on Java 11+. If the target CIB7
      engine already provides JAXB on its classpath, switch this to 'provided'
      (tracked in docs/roadmap.md).
    -->
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>2.3.1</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <!--
      Process-level test stack (test scope): an in-memory CIB seven engine, the
      Connect process-engine plugin that parses and runs <camunda:connector>,
      and H2 as the in-memory database. The test drives the engine through its
      own API, so no JUnit-extension or assertion library is needed.
    -->
    <dependency>
      <groupId>org.cibseven.bpm</groupId>
      <artifactId>cibseven-engine</artifactId>
      <version>${cibseven.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.cibseven.bpm</groupId>
      <artifactId>cibseven-engine-plugin-connect</artifactId>
      <version>${cibseven.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.2.224</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <!--
        Fail the build if a transitive dependency pulls a conflicting version
        of an artifact already on the tree — the guard for the Jackson pin
        above. Runs in the validate phase, so CI catches a split early.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>enforce-dependency-convergence</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <dependencyConvergence>
                  <!--
                    Exclude datasonnet-mapper's transitive Scala / sjsonnet
                    runtime — a third-party tree whose internal version spread
                    (scala-library, geny) we neither control nor police.
                    Everything else, Jackson above all, must converge.
                  -->
                  <excludes>
                    <exclude>org.scala-lang:*</exclude>
                    <exclude>org.scala-lang.modules:*</exclude>
                    <exclude>com.lihaoyi:*</exclude>
                  </excludes>
                </dependencyConvergence>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
