<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.cibseven.community</groupId>
  <artifactId>rest-datasonnet-connector</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>rest-datasonnet connector</name>
  <description>
    CIB seven (Camunda 7 fork) Connect SPI connector for calling external REST
    APIs with DataSonnet request/response/error mapping and a business-vs-system
    error model. See docs/ for the reviewed design.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>11</maven.compiler.release>
    <junit.version>5.11.3</junit.version>
  </properties>

  <!--
    DEPENDENCIES STILL TO ADD, once the coordinates are confirmed against the
    target CIB7 version (tracked in docs/roadmap.md "Open items"):
      * the CIB seven Connect SPI module (AbstractConnector, ConnectorProvider)
      * org.apache.httpcomponents.client5:httpclient5   => scope: provided
      * WireMock                                        => scope: test
    The CIB7 Connect SPI artifact is the blocker for the connector/SPI classes;
    StatusClassifier and DataSonnetMapper need none of it.
  -->
  <dependencies>
    <!--
      datasonnet-mapper 2.5.2: latest stable in the javax-compatible 2.x line.
      The final version pin is a roadmap open item (confirm against the engine's
      Jackson version). The Mapper API used here is stable across 2.x.
    -->
    <dependency>
      <groupId>com.datasonnet</groupId>
      <artifactId>datasonnet-mapper</artifactId>
      <version>2.5.2</version>
    </dependency>

    <!--
      DataSonnet 2.5.x's Java format plugin references javax.xml.bind (JAXB),
      which was removed from the JDK in Java 11. Bundle the javax-namespaced
      JAXB runtime so the connector works on Java 11+. If the target CIB7
      engine already provides JAXB on its classpath, switch this to 'provided'
      (tracked in docs/roadmap.md).
    -->
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>2.3.1</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
    </plugins>
  </build>
</project>
